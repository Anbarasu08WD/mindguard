
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=replace_with_secure_secret
FERNET_KEY=generate_valid_fernet_key

DATABASE_URL=postgresql+psycopg://mindguard_app:YOUR_APP_PASSWORD@YOUR_HOST:5432/mindguard_db

DB_HOST=YOUR_HOST
DB_PORT=5432
DB_NAME=mindguard_db
DB_USER=mindguard_app
DB_PASSWORD=YOUR_APP_PASSWORD

MIGRATION_DATABASE_URL=postgresql+psycopg://mindguard_migrator:YOUR_MIGRATOR_PASSWORD@YOUR_HOST:5432/mindguard_db

# Timezone used for "today", streaks and reminders (Vercel runs on UTC). Example: Asia/Kolkata
APP_TIMEZONE=UTC
